{
  "expo": {
    "name": "HealthConnect",
    "slug": "HealthConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FA"
    },

    "plugins": ["@config-plugins/react-native-webrtc"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.HealthConnect",
      "infoPlist": {
        "NSCameraUsageDescription": "Video calls with your provider.",
        "NSMicrophoneUsageDescription": "Audio during video calls."
      },
      "bitcode": false
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      },

      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F7F8FA"
      },

      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.HealthConnect",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {
      "eas": {
        "projectId": "0921d27f-a9ff-453e-b512-5bb2d221d853"
      }
    }
  }
}
